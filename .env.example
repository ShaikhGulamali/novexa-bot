# ==========================================
# NOVEXA - ENVIRONMENT CONFIG
# ==========================================

# Your Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Bot Owner Discord User ID (comma-separated if multiple)
OWNER_IDS=123456789012345678

# Default Prefix (Used for fallback commands or mentions)
BOT_PREFIX=/

# Database File Path (Optional, defaults to database/gulamali_bot.db)
DATABASE_PATH=database/gulamali_bot.db

# Environment mode: development or production
ENVIRONMENT=production

# ==========================================
# AI CODING AGENT CONFIGURATION
# ==========================================
# Provide at least ONE of the following API keys to enable the AI Coding Agent:

# Google Gemini API Key (Recommended for fast vision & code reasoning)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (For GPT-4o, GPT-4o-mini vision models)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek API Key (For deepseek-chat & deepseek-reasoner)
# Get your key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Custom OpenAI-Compatible Provider (e.g. Groq, OpenRouter, Ollama)
AI_API_KEY=your_custom_ai_api_key_here
AI_BASE_URL=https://api.openai.com/v1

# Default Provider & Model
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-1.5-flash
AI_MAX_CONTEXT_MESSAGES=8
AI_MEMORY_RETENTION_MINUTES=60
AI_DEFAULT_USER_LIMIT_HOURLY=30
AI_COOLDOWN_SECONDS=3
AI_MAX_ATTACHMENT_SIZE_MB=8

# ==========================================
# NOVEXA CONNECTED WEBSITE & OAUTH2
# ==========================================
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/callback
SESSION_SECRET=novexa_jwt_session_secret_change_in_production
DASHBOARD_PORT=8080
DASHBOARD_HOST=0.0.0.0

